# ====== Cupperlab · Diagnóstico SEO+GEO — configuración ======
# Copia este archivo como .env y rellena tus valores.

# --- Datos de contacto que salen en la landing y el correo ---
CUPPERLAB_PHONE=+34 600 000 000
CUPPERLAB_EMAIL=soporte@cupperlab.com
CUPPERLAB_SITE=https://cupperlab.com
CUPPERLAB_CALENDLY=

# --- SMTP para enviar el diagnóstico al cliente ---
# Si lo dejas vacío, la app funciona igual pero NO envía correos (modo maqueta).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=soporte@cupperlab.com
SMTP_FROM_NAME=Cupperlab
# Bandeja interna donde llegan los leads (por defecto CUPPERLAB_EMAIL)
LEAD_INBOX=soporte@cupperlab.com

# --- PageSpeed Insights (opcional): mejora la nota técnica con la velocidad real ---
# Consíguela gratis en https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PSI_API_KEY=

# --- Límites y tiempos (motor v2) ---
RATE_LIMIT_PER_HOUR=30
ANALYSIS_HARD_TIMEOUT=120      # tope global del análisis (s)
ANALYSIS_TOTAL_BUDGET=45       # lectura de la home + señales técnicas
STAGE_BUDGET_CRAWL=50
STAGE_BUDGET_ONPAGE=65
STAGE_BUDGET_PSI=60            # por estrategia (móvil / escritorio), 2 intentos
STAGE_BUDGET_PLACES=10
STAGE_BUDGET_SERP=20
AI_GEO_BUDGET=45               # ronda de preguntas a la IA
AI_CALL_TIMEOUT=30             # por llamada a la IA
MAX_CONCURRENT_JOBS=3
RESULT_CACHE_TTL=86400         # 24 h: el mismo dominio no vuelve a gastar IA ni APIs
ENGINE_VERSION=v2.0            # cambia la versión para invalidar la caché tras un cambio de motor
PORT=8000

# --- Consulta REAL a la IA (GEO). Sin key usa señales heurísticas. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001


# --- OpenAI: modelo mini para P1/P3/P4 (JSON) y ChatGPT con web_search para P2 ---
# Usa el modelo "mini" vigente de OpenAI (revisa el nombre actual en platform.openai.com).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o-mini   # el que "responde al cliente" (P2); idealmente el mismo que usa ChatGPT

# --- Gemini (Google AI Studio). Alternativa si AI_PROVIDER=gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash   # revisa el nombre vigente en AI Studio

# --- Google REAL (posición de marca, búsquedas de cliente, indexación) vía Serper.dev ---
# 5 créditos por análisis (~0,005 $). 2.500 gratis al registrarse. Sin clave: "no medido".
SERPER_API_KEY=

# URL publica del sitio (enlace "Abrir informe" del correo). En produccion: https://tudominio.com
PUBLIC_BASE_URL=

# --- Ficha de Google, reseñas, categoría y ciudad REALES (Places API New) ---
# ÚNICA fuente de la ficha en v2 (la IA ya no opina). Habilita "Places API (New)" en el
# proyecto GCP y restringe la clave a esa API. ~0,03 EUR por análisis. Sin clave: "no medido".
GOOGLE_PLACES_API_KEY=

# --- Motores que "responden al cliente" en el test GEO (P2). Coste ~0,03-0,05 EUR por motor y análisis.
# Por defecto 2 (ChatGPT + Perplexity). Añade gemini si quieres la matriz de 3.
AI_ENGINES=openai,perplexity
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
