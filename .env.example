# ====== Cupperlab · Diagnóstico SEO+GEO — configuración ======
# Copia este archivo como .env y rellena tus valores.

# --- Datos de contacto que salen en la landing y el correo ---
CUPPERLAB_PHONE=+34 600 000 000
CUPPERLAB_EMAIL=soporte@cupperlab.com
CUPPERLAB_SITE=https://cupperlab.com
CUPPERLAB_CALENDLY=

# --- SMTP para enviar el diagnóstico al cliente ---
# Si lo dejas vacío, la app funciona igual pero NO envía correos (modo maqueta).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=soporte@cupperlab.com
SMTP_FROM_NAME=Cupperlab
# Bandeja interna donde llegan los leads (por defecto CUPPERLAB_EMAIL)
LEAD_INBOX=soporte@cupperlab.com

# --- PageSpeed Insights (opcional): mejora la nota técnica con la velocidad real ---
# Consíguela gratis en https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PSI_API_KEY=

# --- Límites y tiempos ---
RATE_LIMIT_PER_HOUR=30
ANALYSIS_HARD_TIMEOUT=50
ANALYSIS_TOTAL_BUDGET=45
PORT=8000

# --- Consulta REAL a la IA (GEO). Sin key usa señales heurísticas. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Motor de IA: 'openai' (ChatGPT, por defecto), 'gemini' o 'auto' ---
AI_PROVIDER=openai

# --- OpenAI (ChatGPT) con busqueda web en vivo. Economico: gpt-4o-mini ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Para lo que necesita mas precision (busqueda web). gpt-4o-mini = economico; sube a gpt-4o si hace falta
OPENAI_MODEL_STRONG=gpt-4o-mini

# --- Gemini (Google AI Studio). Alternativa si AI_PROVIDER=gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Posicion en Google + competencia (elige uno) ---
# Opcion A (renovable 100/dia): SEARCH_PROVIDER=cse + GOOGLE_CSE_ID + GOOGLE_CSE_KEY (reutiliza la de PSI)
# Opcion B (2500 gratis): SEARCH_PROVIDER=serper + SERPER_API_KEY
SEARCH_PROVIDER=
SERPER_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=

# URL publica del sitio (enlace "Abrir informe" del correo). En produccion: https://tudominio.com
PUBLIC_BASE_URL=

# --- Ficha de Google Business por SCRIPT (Places API, sin gastar IA) ---
# Habilita "Places API (New)" en el proyecto de Google Cloud y pon aqui la clave
# (puede ser la misma GOOGLE_PSI_API_KEY si ese proyecto tiene Places API activa).
GOOGLE_PLACES_API_KEY=
